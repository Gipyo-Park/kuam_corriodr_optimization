                    W_half=W_half, ground_speed_mps=ground_speed_mps,
                    bank_angle_deg=bank_angle_deg, min_turn_radius_m=min_turn_radius_m,
                    check_corridor_nfz=check_corridor_nfz, check_turn_radius=check_turn_radius,
                    check_heading_continuity=check_heading_continuity,
                    prev_segment_heading=None
                )

                results.append((vn_idx, vn, pop2, f2, hd2, init_solutions))

            best = None
            best_score = float("inf")
            for vn_idx, vn, pop2, f2, hd2, init_solutions in results:
                if (not pop2) or f2.size == 0:
                    continue
                fronts = fast_non_dominated_sort(f2)
                if not fronts or not fronts[0]:
                    continue
                front1 = np.array(fronts[0], dtype=int)
                norm_f = normalize_objectives(f2[front1, :])
                score = float(np.min(np.linalg.norm(norm_f, axis=1)))
                if score < best_score:
                    best_score = score
                    best = (vn, pop2, f2, hd2, init_solutions)

            if best is None:
                representative_paths_final.append([])
                all_stage1_solutions_history.append([])
                prev_heading = None
                continue

            best_vn, pop2, f2, hd2, init_solutions = best
            reps = pick_representatives(pop2, f2)
            representative_paths_final.append(reps)
            all_stage1_solutions_history.append(init_solutions)

            if hd2 is not None:
                segment_headings.append(hd2)
                prev_heading = hd2
            else:
                prev_heading = None

            points[0, :] = best_vn
            multistart_cache_used = True
            continue

        pop1, f1, _ = run_nsga3_segment(
            nodes=emergency_points, p1=p1, p2=p2,
            Norm_RT=Norm_RiskTensor, AirRisk=AirRisk, use_map=use_heading_map,
            f_limit=flight_dist_limit, f_zones=forbidden_zones,
            Nmax=Nmax_stage1, N_pop=N_pop_stage1, ratio=offspring_ratio_stage1,
            alt=altitude_levels, cs=cell_size, scales=refine_scales,
            air_risk_threshold=1.0,
            dz=delta_z_max, w_d=w_dist, w_g=w_ground, w_a=w_air,
            lat_lim=lat_lim, lon_lim=lon_lim,
            MAX_INIT_ATTEMPTS=MAX_INIT_ATTEMPTS_stage1,
            min_inter_nodes=MIN_INTER_NODES_stage1,
            max_inter_nodes=MAX_INTER_NODES_stage1,
            initial_population=None,
            W_half=W_half, ground_speed_mps=ground_speed_mps,
            bank_angle_deg=bank_angle_deg, min_turn_radius_m=min_turn_radius_m,
            check_corridor_nfz=check_corridor_nfz, check_turn_radius=check_turn_radius,
            check_heading_continuity=check_heading_continuity,
            prev_segment_heading=prev_heading
        )

        init_solutions = []
        if pop1 and f1.size > 0:
            init_solutions = pick_representatives(pop1, f1)
        all_stage1_solutions_history.append(init_solutions)

        nodes_stage2, all_grid_nodes = generate_nodes_3d_segment(
            p1, p2, W_buf, node_grid_resolution_m, lat_lim, lon_lim, Ny, Nx, forbidden_zones
        )

        if nodes_stage2.size == 0:
            representative_paths_final.append([])
            continue

        half_all = int(all_grid_nodes.shape[0] // 2)
        base_target = int(max(MIN_SAFE_NODES_TARGET, half_all))
        current_target = int(min(base_target, nodes_stage2.shape[0]))

        node_lons = nodes_stage2[:, 1]
        node_lats = nodes_stage2[:, 0]
        I_nodes = ((node_lons - lon_lim[0]) / (lon_lim[1] - lon_lim[0]) * (Nx - 1)).astype(int)
        J_nodes = ((node_lats - lat_lim[0]) / (lat_lim[1] - lat_lim[0]) * (Ny - 1)).astype(int)
        I_nodes = np.clip(I_nodes, 0, Nx - 1)
        J_nodes = np.clip(J_nodes, 0, Ny - 1)
        alt_idx = int(np.argmin(np.abs(altitude_levels - nodes_stage2[0, 2])))

        air_slice = AirRisk[:, :, alt_idx]
        node_risks = air_slice[J_nodes, I_nodes]

        safe_nodes = nodes_stage2
        current_threshold = 0.0
        for perc in SAFE_NODE_PERCENTILE_LIST:
            thr = float(np.percentile(node_risks, perc))
            current_threshold = thr
            safe_nodes = nodes_stage2[node_risks <= thr]
            if safe_nodes.shape[0] >= current_target:
                break
        if safe_nodes.size == 0:
            safe_nodes = nodes_stage2

        pop2, f2, hd2 = run_nsga3_segment(
            nodes=safe_nodes, p1=p1, p2=p2,
            Norm_RT=Norm_RiskTensor, AirRisk=AirRisk, use_map=use_heading_map,
            f_limit=flight_dist_limit, f_zones=forbidden_zones,
            Nmax=Nmax_stage2, N_pop=N_pop_stage2, ratio=offspring_ratio_stage2,
            alt=altitude_levels, cs=cell_size, scales=refine_scales,
            air_risk_threshold=current_threshold,
            dz=delta_z_max, w_d=w_dist, w_g=w_ground, w_a=w_air,
            lat_lim=lat_lim, lon_lim=lon_lim,
            MAX_INIT_ATTEMPTS=MAX_INIT_ATTEMPTS_stage2,
            min_inter_nodes=MIN_INTER_NODES_stage2,
            max_inter_nodes=MAX_INTER_NODES_stage2,
            initial_population=init_solutions,
            W_half=W_half, ground_speed_mps=ground_speed_mps,
            bank_angle_deg=bank_angle_deg, min_turn_radius_m=min_turn_radius_m,
            check_corridor_nfz=check_corridor_nfz, check_turn_radius=check_turn_radius,
            check_heading_continuity=check_heading_continuity,
            prev_segment_heading=prev_heading
        )

        if pop2 and f2.size > 0:
            reps = pick_representatives(pop2, f2)
            representative_paths_final.append(reps)
        else:
            representative_paths_final.append([])

        if hd2 is not None:
            segment_headings.append(hd2)
            prev_heading = hd2

    result = {
        "objective_names": objective_names,
        "representative_paths_final": representative_paths_final,
        "all_stage1_solutions_history": all_stage1_solutions_history,
        "points": points,
        "vertiport": vertiport,
        "forbidden_zones": forbidden_zones,
        "emergency_points": emergency_points,
        "lat_lim": lat_lim,
        "lon_lim": lon_lim,
        "W_half": W_half
    }

